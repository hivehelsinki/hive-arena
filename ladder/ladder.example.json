{
	"dataDir": "data",
	"minFreeDiskGB": 5,
	"timezone": "Europe/Helsinki",
	"ladder": {
		"formats": [
			{"map": "random", "players": 2},
			{"map": "random", "players": 3},
			{"map": "random", "players": 4},
			{"map": "random", "players": 6}
		],
		"quota": 20,
		"window": 4,
		"randomShare": 0.1,
		"maxFailures": 5,
		"keepMatchFiles": 100,
		"headToHeadPeriod": "168h",
		"paused": false,
		"rating": {
			"mu": 25,
			"sigma": 8.333333333333334,
			"beta": 4.166666666666667,
			"tau": 0.08333333333333333,
			"versionSigma": 4.166666666666667
		}
	},
	"runner": {
		"serverImage": "hive-arena-server",
		"cores": 2,
		"memory": "256m",
		"serverMemory": "2g",
		"pids": 64,
		"joinTimeout": "1m",
		"matchTimeout": "30m"
	},
	"registry": {
		"url": "https://github.com/hivehelsinki/hive-arena-teams.git",
		"branch": "main",
		"file": "teams.json"
	},
	"build": {
		"timeout": "10m",
		"keepImages": 3,
		"smokeMap": "tiny",
		"maxImageMB": 2048,
		"cacheLimit": "10GB",
		"interval": "15m"
	},
	"web": {
		"listen": ":8080",
		"viewerDir": "viewer/web",
		"backupToken": ""
	}
}
